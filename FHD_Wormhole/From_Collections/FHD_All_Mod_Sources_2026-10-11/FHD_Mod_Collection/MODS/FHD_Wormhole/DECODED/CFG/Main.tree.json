                                                      {
                                                        "name": "OnPressCode",
                                                        "block": {
                                                          "sorted": true,
                                                          "entries": [
                                                            {
                                                              "name": "01",
                                                              "value": "dword wh_hull=ShipEqInSlot(Player(),t_Hull);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "02",
                                                              "value": "dword wh_engine=ShipEqInSlot(Player(),t_Engine);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "03",
                                                              "value": "int wh_core=FindBonusByCustomTag('FHD_WormholeV2_Core');",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "04",
                                                              "value": "int wh_eng_core=FindBonusByCustomTag('FHD_WormholeV2_EngineCore');",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "05",
                                                              "value": "if(wh_core<0||wh_eng_core<0){MessageBox(CT('Script.FHD_Wormhole.ConfigError'));exit;}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "06",
                                                              "value": "int wh_has_hull=0;int wh_has_engine=0;if(wh_hull){if(ItemExtraSpecialsCountByType(wh_hull,wh_core))wh_has_hull=1;}if(wh_engine){if(ItemExtraSpecialsCountByType(wh_engine,wh_eng_core))wh_has_engine=1;}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "07",
                                                              "value": "if(!wh_has_hull&&!wh_has_engine){MessageBox(CT('Script.FHD_Wormhole.NoModule'));exit;}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "08",
                                                              "value": "if(!ShipInNormalSpace(Player())){MessageBox(CT('FormShip.UseOnlyInSpace'));exit;}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "09",
                                                              "value": "if(ShipFindCustomShipInfoByType(Player(),'FHDWormholeRuntime')==-1)ShipAddCustomShipInfo(Player(),'FHDWormholeRuntime','NoShow');",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "10",
                                                              "value": "int wh_now=CurTurn();int wh_ready=ShipCustomShipInfoData(Player(),'FHDWormholeRuntime',1);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "11",
                                                              "value": "if(wh_ready>wh_now){MessageBox(CT('Script.FHD_Wormhole.CooldownPrefix')+(wh_ready-wh_now)+CT('Script.FHD_Wormhole.CooldownSuffix'));exit;}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "12",
                                                              "value": "if(!MessageBoxYesNo(CT('Script.FHD_Wormhole.Confirm')))exit;",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "13",
                                                              "value": "int wh_old_order=ShipOrder(Player());dword wh_old_obj=ShipOrderObj(Player());",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "14",
                                                              "value": "RunChildForm('Galaxy');",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "15",
                                                              "value": "if(ShipOrder(Player())!=7)exit;",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "16",
                                                              "value": "dword wh_new_obj=ShipOrderObj(Player());if(wh_old_order==7&&wh_new_obj==wh_old_obj)exit;",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "17",
                                                              "value": "dword wh_tank=ShipEqInSlot(Player(),t_FuelTanks);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "18",
                                                              "value": "for(int wh_i=ShipItems(Player())-1;wh_i>=1;wh_i=wh_i-1)",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "19",
                                                              "value": "{",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "20",
                                                              "value": "dword wh_item=ShipItems(Player(),wh_i);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "21",
                                                              "value": "if(!wh_item)continue;if(!ItemIsInUse(wh_item))continue;if(ItemType(wh_item)<t_Hull)continue;if(ItemType(wh_item)==t_Hull)continue;",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "22",
                                                              "value": "if(wh_item==wh_engine||wh_item==wh_tank)continue;",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "23",
                                                              "value": "if(ItemCanBeBroken(wh_item)){if(ItemDurability(wh_item)>1)ItemDurability(wh_item,1);}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "24",
                                                              "value": "}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "25",
                                                              "value": "if(wh_engine){if(ItemCanBeBroken(wh_engine)){if(ItemDurability(wh_engine)>10)ItemDurability(wh_engine,10);}}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "26",
                                                              "value": "if(wh_tank){if(ItemCanBeBroken(wh_tank)){if(ItemDurability(wh_tank)>10)ItemDurability(wh_tank,10);}}",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "27",
                                                              "value": "ShipCustomShipInfoData(Player(),'FHDWormholeRuntime',1,wh_now+30);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "28",
                                                              "value": "InterfaceState('Ship','FHDWormholeLock',1);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
                                                            {
                                                              "name": "29",
                                                              "value": "ShipOrderData1(Player(),1);",
                                                              "metadata": [
                                                                0,
                                                                1
                                                              ]
                                                            },
